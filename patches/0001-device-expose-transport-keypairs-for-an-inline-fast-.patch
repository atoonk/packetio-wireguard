new file mode 100644
index 0000000..f194c2e
--- /dev/null
+++ b/device/fastpath_keypair_test.go
@@ -0,0 +1,175 @@
+/* SPDX-License-Identifier: MIT
+ *
+ * Copyright (C) 2017-2025 WireGuard LLC. All Rights Reserved.
+ */
+
+package device
+
+// PACKETIO FORK: the keypair lifecycle and nonce invariants the fast path
+// rests on. fastpath_test.go covers the replay window and the observer;
+// these cover what must hold for a keypair handed outside this package.
+
+import (
+	"sync"
+	"testing"
+	"time"
+)
+
+func TestRetirementFiresBeforeTheIndexIsRemoved(t *testing.T) {
+	pair := genTestPair(t, false)
+	var (
+		mu      sync.Mutex
+		retired int
+	)
+	for i := range pair {
+		i := i
+		d := pair[i].dev
+		d.SetKeypairObserver(func(peer *Peer, kp *Keypair, e KeypairEvent) {
+			if e != KeypairRetired {
+				return
+			}
+			mu.Lock()
+			defer mu.Unlock()
+			retired++
+			if got := d.indexTable.Lookup(kp.LocalIndex()).keypair; got != kp {
+				t.Errorf("dev%d: index %d already gone (or reused) when retirement fired: %p, want %p",
+					i, kp.LocalIndex(), got, kp)
+			}
+		})
+	}
+	done := make(chan struct{})
+	pair.Send(t, Ping, done)
+	pair.Send(t, Pong, done)
+	close(done)
+	pair[0].dev.Close()
+	pair[1].dev.Close()
+	mu.Lock()
+	defer mu.Unlock()
+	if retired == 0 {
+		t.Fatal("no retirement was announced")
+	}
+}
+
+// Every keypair the observer is told about is eventually retired. A fast
+// path holds what it is given until it hears otherwise, so a keypair that
+// is dropped without a retirement is one it would decrypt with forever.
+func TestEveryEstablishedKeypairIsRetired(t *testing.T) {
+	pair := genTestPair(t, false)
+	var (
+		mu    sync.Mutex
+		live  = map[*Keypair]bool{}
+		total int
+	)
+	for i := range pair {
+		pair[i].dev.SetKeypairObserver(func(peer *Peer, kp *Keypair, e KeypairEvent) {
+			mu.Lock()
+			defer mu.Unlock()
+			switch e {
+			case KeypairEstablished:
+				live[kp] = true
+				total++
+			case KeypairRetired:
+				delete(live, kp)
+			}
+		})
+	}
+	done := make(chan struct{})
+	pair.Send(t, Ping, done)
+	pair.Send(t, Pong, done)
+	// Force a rotation: a fresh handshake on top of the live session.
+	for i := range pair {
+		for _, peer := range pair[i].dev.peers.keyMap {
+			peer.SendHandshakeInitiation(false)
+		}
+	}
+	time.Sleep(200 * time.Millisecond)
+	pair.Send(t, Ping, done)
+	close(done)
+	pair[0].dev.Close()
+	pair[1].dev.Close()
+	mu.Lock()
+	defer mu.Unlock()
+	if total < 2 {
+		t.Fatalf("only %d keypairs established", total)
+	}
+	if len(live) != 0 {
+		t.Fatalf("%d of %d keypairs were dropped without a retirement", len(live), total)
+	}
+}
+
+// Concurrent reservations carve the counter space into disjoint ranges:
+// two senders must never be handed the same nonce, and none may be handed
+// one past the limit.
+func TestReserveNoncesConcurrentRangesNeverOverlap(t *testing.T) {
+	kp := testKeypair(t)
+	const (
+		goroutines = 8
+		reserves   = 500
+		size       = 7
+	)
+	seen := make([]bool, goroutines*reserves*size+16)
+	var mu sync.Mutex
+	var wg sync.WaitGroup
+	for i := 0; i < goroutines; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for j := 0; j < reserves; j++ {
+				start, ok := kp.ReserveNonces(size)
+				if !ok {
+					t.Error("reservation refused well below the limit")
+					return
+				}
+				mu.Lock()
+				for n := start; n < start+size; n++ {
+					if n >= uint64(len(seen)) {
+						t.Errorf("nonce %d past the space the test reserved", n)
+						mu.Unlock()
+						return
+					}
+					if seen[n] {
+						t.Errorf("nonce %d handed out twice", n)
+					}
+					seen[n] = true
+				}
+				mu.Unlock()
+			}
+		}()
+	}
+	wg.Wait()
+	if got := kp.sendNonce.Load(); got != goroutines*reserves*size {
+		t.Fatalf("counter at %d after %d nonces", got, goroutines*reserves*size)
+	}
+}
+
+// The counter must not be pushed over the top by callers that keep asking.
+// There are only 2^13 counts between RejectAfterMessages and 2^64: an
+// unconditional Add would walk through them and wrap, handing out low
+// nonces a second time under the same key.
+func TestReserveNoncesCannotWrapPastTheLimit(t *testing.T) {
+	kp := testKeypair(t)
+	kp.sendNonce.Store(RejectAfterMessages - 1)
+	if _, ok := kp.ReserveNonces(1); !ok {
+		t.Fatal("the last nonce below the limit was refused")
+	}
+	var wg sync.WaitGroup
+	for i := 0; i < 8; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for j := 0; j < 5000; j++ {
+				if _, ok := kp.ReserveNonces(1 + uint64(j%64)); ok {
+					t.Error("a nonce was handed out past the limit")
+					return
+				}
+			}
+		}()
+	}
+	wg.Wait()
+	if got := kp.sendNonce.Load(); got != RejectAfterMessages {
+		t.Fatalf("counter at %d, want it parked at %d", got, uint64(RejectAfterMessages))
+	}
+	if _, ok := kp.ReserveNonces(RejectAfterMessages + 1); ok {
+		t.Fatal("a reservation larger than the whole space succeeded")
+	}
+}
