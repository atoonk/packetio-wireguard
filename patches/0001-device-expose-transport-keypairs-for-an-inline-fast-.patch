@@ -0,0 +1,162 @@
+/* SPDX-License-Identifier: MIT
+ *
+ * Copyright (C) 2017-2025 WireGuard LLC. All Rights Reserved.
+ */
+
+package device
+
+// PACKETIO FORK: tests for fastpath.go.
+
+import (
+	"sync"
+	"testing"
+	"time"
+
+	"golang.org/x/crypto/chacha20poly1305"
+)
+
+func testKeypair(t *testing.T) *Keypair {
+	t.Helper()
+	var key [chacha20poly1305.KeySize]byte
+	kp := new(Keypair)
+	var err error
+	if kp.send, err = chacha20poly1305.New(key[:]); err != nil {
+		t.Fatal(err)
+	}
+	kp.receive = kp.send
+	kp.created = time.Now()
+	kp.replayFilter.Reset()
+	return kp
+}
+
+// A reservation never advances the counter past RejectAfterMessages, and a
+// caller that keeps retrying after exhaustion never sees a nonce twice.
+func TestReserveNoncesClamps(t *testing.T) {
+	kp := testKeypair(t)
+	kp.sendNonce.Store(RejectAfterMessages - 100)
+	start, ok := kp.ReserveNonces(64)
+	if !ok || start != RejectAfterMessages-100 {
+		t.Fatalf("first reservation: start %d ok %v", start, ok)
+	}
+	if _, ok := kp.ReserveNonces(64); ok { // only 36 left
+		t.Fatal("reservation past the limit succeeded")
+	}
+	if got := kp.sendNonce.Load(); got != RejectAfterMessages {
+		t.Fatalf("counter parked at %d, want %d", got, uint64(RejectAfterMessages))
+	}
+	for i := 0; i < 1<<14; i++ { // more retries than there is headroom above the limit
+		if _, ok := kp.ReserveNonces(1); ok {
+			t.Fatalf("retry %d handed out a nonce after exhaustion", i)
+		}
+	}
+	if got := kp.sendNonce.Load(); got != RejectAfterMessages {
+		t.Fatalf("counter moved to %d under retries", got)
+	}
+	if _, ok := kp.ReserveNonces(0); ok {
+		t.Fatal("zero-length reservation succeeded")
+	}
+	old := testKeypair(t)
+	old.created = time.Now().Add(-RejectAfterTime)
+	if _, ok := old.ReserveNonces(1); ok {
+		t.Fatal("expired keypair handed out a nonce")
+	}
+}
+
+// Two validators on one published keypair -- this package's receive path
+// and a fast path -- must accept every counter exactly once between them.
+// With the lock removed this fails: concurrent updates to one ring block
+// lose bits, and counters read as unseen a second time.
+func TestValidateCounterConcurrent(t *testing.T) {
+	kp := testKeypair(t)
+	const n = 200000
+	var (
+		wg       sync.WaitGroup
+		accepted [2][]uint64
+	)
+	for w := 0; w < 2; w++ {
+		wg.Add(1)
+		go func(w int) {
+			defer wg.Done()
+			for c := uint64(w); c < n; c += 2 {
+				if kp.ValidateCounter(c) {
+					accepted[w] = append(accepted[w], c)
+				}
+				// The other validator sees the same counter later: a replay.
+				if kp.ValidateCounter(c ^ 1) {
+					accepted[w] = append(accepted[w], c^1)
+				}
+			}
+		}(w)
+	}
+	wg.Wait()
+	seen := make(map[uint64]int, n)
+	for _, a := range accepted {
+		for _, c := range a {
+			seen[c]++
+		}
+	}
+	for c, k := range seen {
+		if k != 1 {
+			t.Fatalf("counter %d accepted %d times", c, k)
+		}
+	}
+	if len(seen) < n-windowSlack {
+		t.Fatalf("only %d of %d counters accepted", len(seen), n)
+	}
+}
+
+// The window is 8128 wide; a validator running far ahead can legitimately
+// push a few of the other's counters out of it.
+const windowSlack = 8192
+
+// The observer sees a keypair come and go: established on both sides,
+// promoted on the responder, retired when the devices close.
+func TestKeypairObserverLifecycle(t *testing.T) {
+	pair := genTestPair(t, false)
+	type ev struct {
+		dev int
+		ev  KeypairEvent
+	}
+	var (
+		mu     sync.Mutex
+		events []ev
+		kps    = map[*Keypair]bool{}
+	)
+	for i := range pair {
+		i := i
+		pair[i].dev.SetKeypairObserver(func(peer *Peer, kp *Keypair, e KeypairEvent) {
+			mu.Lock()
+			defer mu.Unlock()
+			events = append(events, ev{i, e})
+			if peer == nil {
+				t.Errorf("event %v without a peer", e)
+			}
+			kps[kp] = true
+		})
+	}
+	done := make(chan struct{})
+	pair.Send(t, Ping, done)
+	pair.Send(t, Pong, done)
+	close(done)
+	pair[0].dev.Close()
+	pair[1].dev.Close()
+	mu.Lock()
+	defer mu.Unlock()
+	count := func(e KeypairEvent) (n int) {
+		for _, x := range events {
+			if x.ev == e {
+				n++
+			}
+		}
+		return
+	}
+	if count(KeypairEstablished) < 2 {
+		t.Fatalf("established on %d sides, events %v", count(KeypairEstablished), events)
+	}
+	if count(KeypairPromoted) < 1 {
+		t.Fatalf("no promotion, events %v", events)
+	}
+	if count(KeypairRetired) < len(kps) {
+		t.Fatalf("%d keypairs, %d retirements, events %v", len(kps), count(KeypairRetired), events)
+	}
+}
